{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitStream",
  "version": "1.0.11",
  "identifier": "com.gitstream.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GitStream",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "avv",
    "homepage": "https://github.com/avv7bc/gitstream",
    "copyright": "Copyright © 2026 avv",
    "category": "DeveloperTool",
    "shortDescription": "Desktop Git GUI for everyday workflows",
    "longDescription": "GitStream is a desktop Git GUI focused on everyday Git workflows — commits, branches, push/pull and diff review — without blocking the UI or unnecessary complexity.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
