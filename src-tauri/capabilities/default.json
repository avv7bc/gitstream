{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for GitStream",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "window-state:default",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask"
  ]
}
